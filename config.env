# ==============================================================================
# AI Agent 客制化配置文件 (config.env)
# ==============================================================================

# 0. 配置状态
SETUP_COMPLETED=true

# 1. 图片识别与多模态支持
# Options: true | false
ENABLE_IMAGE_RECOGNITION=true

# 2. 核心大模型 API Keys
DEEPSEEK_MODEL_NAME=deepseek-flash
DEEPSEEK_API_KEY=sk-xxxx
DOUBAO_VISION_MODEL_NAME=doubao-seed-evolving
DOUBAO_API_KEY=ark-xxxx

# 3. 用户 AI 熟练度及交互模式
# Options: proficient | beginner
USER_PROFICIENCY=proficient

# 4. 专属教材与本地知识库
# HAS_TEXTBOOKS Options: true | false
HAS_TEXTBOOKS=true
TEXTBOOK_DIR=./textbook
COPIED_TEXTBOOK_COUNT=2

# 5. 引文位置溯源及标注
# Options: true | false
CITE_TEXTBOOK_LOCATION=true

# 6. 本地系统操作与文件权限
# Options: true | false
REQUIRE_FILE_OPERATION_APPROVAL=true

# 7. UI 外观与界面主题
# Options: light | dark | system
THEME_MODE=light
